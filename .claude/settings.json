{
  "model": "opusplan",
  "permissions": {
    "deny": [
      "Read(node_modules/**)",
      "Read(package-lock.json)",
      "Read(.wrangler/**)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto-commit.sh" }
        ]
      }
    ]
  }
}
